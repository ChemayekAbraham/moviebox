<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp"/><solid android:color="@color/progress_track"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp"/>
            <gradient android:angle="0" android:startColor="#E50914" android:endColor="#FF5A5F"/></shape></clip>
    </item>
</layer-list>
